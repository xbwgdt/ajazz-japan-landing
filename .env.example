# Neon / Vercel Postgres connection string. POSTGRES_URL is also supported.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Survey administrator credentials. Use a unique password and a random 32+ character secret.
SURVEY_ADMIN_PASSWORD=replace-with-a-strong-password
SURVEY_ADMIN_SECRET=replace-with-at-least-32-random-characters
