# Neon / Vercel Postgres connection string. POSTGRES_URL is also supported.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Order administrator credentials. Use a unique password and a random 32+ character secret.
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SECRET=replace-with-at-least-32-random-characters

# Stripe Japan merchant account. Set these only in Railway or a local untracked .env file.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_SITE_URL=https://ajazz.jp

# Secret used by the scheduled reservation cleanup endpoint.
CRON_SECRET=replace-with-a-long-random-value

# RMS WEB SERVICE credentials for InventoryAPI 2.1. Keep these only in Railway.
RMS_SERVICE_SECRET=replace-with-rms-service-secret
RMS_LICENSE_KEY=replace-with-rms-license-key

# Payload CMS and Cloudflare R2. Set values only in Railway or a local untracked .env file.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=xiet@a-jazz.com
BOOTSTRAP_ADMIN_PASSWORD=replace-only-in-railway-or-local-untracked-env
R2_BUCKET=ajazz-japan-media
R2_ACCESS_KEY_ID=replace-only-in-railway
R2_SECRET_ACCESS_KEY=replace-only-in-railway
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.ajazz.jp
