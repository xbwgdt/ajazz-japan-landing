# Neon / Vercel Postgres connection string. POSTGRES_URL is also supported.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Order administrator credentials. Use a unique password and a random 32+ character secret.
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SECRET=replace-with-at-least-32-random-characters

# Stripe Japan merchant account. Set these only in Railway or a local untracked .env file.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_SITE_URL=https://ajazz.jp

# Secret used by the scheduled reservation cleanup endpoint.
CRON_SECRET=replace-with-a-long-random-value

# RMS WEB SERVICE credentials for InventoryAPI 2.1. Keep these only in Railway.
RMS_SERVICE_SECRET=replace-with-rms-service-secret
RMS_LICENSE_KEY=replace-with-rms-license-key
