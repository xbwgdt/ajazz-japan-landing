{
  "name": "ajazz-japan-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3007",
    "build": "next build && node scripts/prepare-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "import:rms": "tsx scripts/import-rms-catalog-cli.ts",
    "payload": "payload",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:migrate": "payload migrate",
    "cms:release:check": "node scripts/verify-cms-release-gate.mjs",
    "cms:migrate:create": "payload migrate:create",
    "cms:migrate-catalog": "tsx scripts/migrate-catalog-to-cms.ts",
    "cms:bootstrap-admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@payloadcms/db-postgres": "^3.87.0",
    "@payloadcms/next": "^3.87.0",
    "@payloadcms/richtext-lexical": "^3.87.0",
    "@payloadcms/storage-s3": "^3.87.0",
    "@payloadcms/ui": "^3.87.0",
    "exceljs": "4.4.0",
    "lucide-react": "^1.30.0",
    "next": "16.2.10",
    "payload": "^3.87.0",
    "postgres": "^3.4.9",
    "qs-esm": "8.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.34.5",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "happy-dom": "^20.11.1",
    "tsx": "4.21.0",
    "typescript": "^5",
    "vitest": "3.2.4"
  },
  "overrides": {
    "uuid": "11.1.1",
    "postcss": "8.5.10"
  }
}
